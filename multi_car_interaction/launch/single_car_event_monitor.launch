<?xml version="1.0"?>
<!--
  Single-Car Race Event Monitor Launch File
  
  Launches race_event_monitor.py configured for single-car mode monitoring.
  Can be used for both time trial and obstacle modes.
  
  Usage:
    # Time trial mode (no obstacle):
    roslaunch multi_car_interaction single_car_event_monitor.launch race_mode:=single_car_no_obstacle
    
    # With dummy obstacle:
    roslaunch multi_car_interaction single_car_event_monitor.launch race_mode:=single_car_obstacle
-->
<launch>
    <!-- Race mode configuration -->
    <arg name="race_mode" default="single_car_no_obstacle" 
         doc="Race mode: single_car_no_obstacle / single_car_obstacle"/>
    
    <!-- Collision detection parameters (same as multi-car) -->
    <arg name="warning_distance" default="1.5"/>
    <arg name="critical_distance" default="0.8"/>
    <arg name="collision_distance" default="0.4"/>
    
    <!-- Car model and dimensions -->
    <arg name="car_model" default="NUC2"/>
    <arg name="car_length" default="0.58"/>
    <arg name="car_width" default="0.31"/>
    
    <!-- Track boundary parameters -->
    <arg name="boundary_safety_margin" default="0.0"/>
    <arg name="boundary_violation_tolerance" default="0.05"/>
    
    <!-- Monitoring rate -->
    <arg name="check_rate" default="80.0"/>
    
    <!-- Launch Race Event Monitor -->
    <node pkg="multi_car_interaction" type="race_event_monitor.py" 
          name="race_event_monitor" output="screen">
      <!-- Set race mode -->
      <param name="race_mode" value="$(arg race_mode)"/>
      
      <!-- Car configuration (empty for single-car, will be set internally) -->
      <param name="car_model" value="$(arg car_model)"/>
      <param name="check_rate" value="$(arg check_rate)"/>
      
      <!-- Collision detection parameters -->
      <param name="warning_distance" value="$(arg warning_distance)"/>
      <param name="critical_distance" value="$(arg critical_distance)"/>
      <param name="collision_distance" value="$(arg collision_distance)"/>
      <param name="car_length" value="$(arg car_length)"/>
      <param name="car_width" value="$(arg car_width)"/>
      
      <!-- Track boundary parameters -->
      <param name="boundary_safety_margin" value="$(arg boundary_safety_margin)"/>
      <param name="boundary_violation_tolerance" value="$(arg boundary_violation_tolerance)"/>
      
      <param name="track_width_limit" value="1.5"/>
      <param name="log_directory" value="/tmp/race_logs"/>
    </node>

</launch>
