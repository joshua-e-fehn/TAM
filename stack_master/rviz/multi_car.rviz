Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 160
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Filter (blacklist):
      Filter (whitelist):
      Marker Scale: 0.3
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree: {}
      Update Interval: 0
      Value: true
    - Class: rviz/RobotModel
      Enabled: true
      Name: car1_model
      Robot Description: car1/racecar/robot_description
      TF Prefix: car1
      Update Interval: 0
      Value: true
      Alpha: 1.0
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz/RobotModel
      Enabled: true
      Name: car2_model
      Robot Description: car2/racecar/robot_description
      TF Prefix: car2
      Update Interval: 0
      Value: true
      Alpha: 0.7
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz/Map
      Alpha: 0.7
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Name: Map
      Topic: /car1/map
      Unreliable: false
      Value: true
    - Class: rviz/Map
      Alpha: 0.3
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: true
      Name: Map_car2
      Topic: /car2/map
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /car1/perception/static_dynamic_marker_pub
      Name: car1_tracking_markers
      Namespaces: {}
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /car2/perception/static_dynamic_marker_pub
      Name: car2_tracking_markers
      Namespaces: {}
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /car1/global_waypoints/markers
      Name: car1_waypoints
      Namespaces: {}
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /car2/global_waypoints/markers
      Name: car2_waypoints
      Namespaces: {}
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /car1/global_waypoints/shortest_path/markers
      Name: car1_shortest_path_markers
      Namespaces: {}
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /car2/global_waypoints/shortest_path/markers
      Name: car2_shortest_path_markers
      Namespaces: {}
      Queue Size: 100
      Value: true
  Enabled: true
  Global Options:
    Background Color: 0; 0; 0
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/FocusCamera
    - Class: rviz/Interact
    - Class: rviz/Select
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
    - Class: rviz/SetGoal
  Value: true
  Views:
    Current:
      Class: rviz/ThirdPersonFollower
      Distance: 10
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: ThirdPersonFollower
      Near Clip Distance: 0.01
      Pitch: 0.785
      Target Frame: map
      Yaw: 0.785
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Width: 1600
  X: 50
  Y: 50
