<?xml version="1.0"?>
<launch>
  <!-- Optimized Multi-Car Launch File with Reduced Relay Dependencies -->
  <!-- September 2025: Streamlined architecture replacing excessive relay chains -->
  
  <!-- List of car namespaces to spawn -->
  <arg name="cars" default="car1,car2"/>
  <!-- Per-car planner selection (comma separated, aligns with cars) -->
  <arg name="planners" default="spliner,spliner"/>
  <!-- Per-car map names (comma separated) -->
  <arg name="maps" default="M1,M1"/>
  <!-- Single global map argument (preferred). Overrides individual defaults unless explicitly set per car. -->
  <arg name="global_map" default="M1"/>
  <!-- Per-car racecar versions (hardware profiles) -->
  <arg name="versions" default="NUC2,NUC2"/>
  <!-- Optional per-car frame prefixes (comma separated) -->
  <arg name="frame_prefixes" default="car1_,car2_"/>
  <!-- Simulation flag applied to all cars -->
  <arg name="sim" default="True"/>
  <!-- Launch a single consolidated RViz instead of one per car -->
  <arg name="rviz" default="True"/>
  <!-- Global neutral map frame support -->
  <arg name="use_global_map" default="True"/>
  <arg name="global_map_frame" default="map"/>
  
  <!-- Multi-Car Interaction Arguments -->
  <arg name="enable_car_interaction" default="True"/>
  <arg name="enable_collision_detection" default="True"/>
  <arg name="collision_warning_distance" default="1.5"/>
  <arg name="collision_critical_distance" default="0.8"/>

  <!-- Global Map Server - shared by all cars -->
  <node pkg="map_server" name="global_map_server" type="map_server" 
        args="$(find stack_master)/maps/$(arg global_map)/$(arg global_map).yaml"/>
  
  <!-- Global Waypoint Publisher - shared by all cars -->
  <node name="global_waypoint_publisher" pkg="gb_optimizer" type="global_trajectory_publisher.py" output="screen">
    <param name="global_republisher/map_name" value="$(arg global_map)"/>
  </node>

  <!-- Helper python expansion using eval is brittle; split CSV lists in bash style via subst args -->
  <!-- We iterate by index because roslaunch lacks native list iteration; replicate pattern for 4 cars max -->
  <arg name="car1" default="car1"/>
  <arg name="car2" default="car2"/>
  <arg name="car3" default=""/>
  <arg name="car4" default=""/>

  <!-- Internal: map each idx to selected value by position using subst; users can override directly -->
  <arg name="planner_car1" default="spliner"/>
  <arg name="planner_car2" default="spliner"/>
  <arg name="planner_car3" default="spliner"/>
  <arg name="planner_car4" default="spliner"/>

  <arg name="map_car1" default="$(arg global_map)"/>
  <arg name="map_car2" default="$(arg global_map)"/>
  <arg name="map_car3" default="$(arg global_map)"/>
  <arg name="map_car4" default="$(arg global_map)"/>

  <arg name="version_car1" default="NUC2"/>
  <arg name="version_car2" default="NUC2"/>
  <arg name="version_car3" default="NUC2"/>
  <arg name="version_car4" default="NUC2"/>

  <arg name="frame_prefix_car1" default="car1_"/>
  <arg name="frame_prefix_car2" default="car2_"/>
  <arg name="frame_prefix_car3" default="car3_"/>
  <arg name="frame_prefix_car4" default="car4_"/>

  <!-- =============================================== -->
  <!-- OPTIMIZATION: Parameterized Car Template      -->
  <!-- =============================================== -->
  <!-- This template reduces duplication and enables easier maintenance -->
  
  <!-- Car 1 - Optimized Configuration -->
  <group if="$(eval car1 != '')" ns="$(arg car1)">
    <param name="frame_prefix" value="$(arg frame_prefix_car1)"/>
    <!-- Set frame parameters for f1tenth_simulator to use prefixed frames -->
    <param name="f1tenth_simulator/base_frame" value="$(arg frame_prefix_car1)base_link"/>
    <param name="f1tenth_simulator/scan_frame" value="$(arg frame_prefix_car1)laser"/>
    <param name="f1tenth_simulator/map_frame" value="$(arg frame_prefix_car1)map"/>
    <!-- Set car1 initial position -->
    <param name="f1tenth_simulator/car_init_x" value="-2.0"/>
    <param name="f1tenth_simulator/car_init_y" value="-1.0"/>
    <param name="f1tenth_simulator/car_init_theta" value="0.0"/>
    
    <!-- ============================================= -->
    <!-- OPTIMIZATION: Enhanced Topic Remapping      -->
    <!-- ============================================= -->
    <!-- Replace relay chains with direct topic remapping where possible -->
    
    <!-- Headtohead Planning with Per-Car Topic Isolation -->
    <include file="$(find stack_master)/launch/headtohead.launch">
      <arg name="car_name" value="$(arg car1)"/>
      <arg name="planner" value="$(arg planner_car1)"/>
      <arg name="racecar_version" value="$(arg version_car1)"/>
      <arg name="measure" value="False"/>
      <arg name="map_name" value="$(arg map_car1)"/>
      <!-- OPTIMIZATION: Parameterized topics for proper namespace isolation -->
      <arg name="global_waypoints_topic" value="/global_waypoints"/>
      <arg name="global_waypoints_scaled_topic" value="/global_waypoints_scaled"/>
      <arg name="global_waypoints_overtaking_topic" value="/global_waypoints/overtaking"/>
      <arg name="planner_output_topic" value="planner/avoidance/otwpnts"/>
    </include>
    
    <!-- Base System with Enhanced Remapping -->
    <include file="$(find stack_master)/launch/base_system.launch">
      <arg name="map_name" value="$(arg map_car1)"/>
      <arg name="racecar_version" value="$(arg version_car1)"/>
      <arg name="sim" value="$(arg sim)"/>
      <arg name="frame_prefix" value="$(arg frame_prefix_car1)"/>
      <arg name="rviz" value="False"/>
      <arg name="include_frenet_republisher" value="False"/>
      <!-- OPTIMIZATION: Direct topic remapping for simulator integration -->
      <remap from="f1tenth_simulator/scan" to="scan"/>
      <remap from="f1tenth_simulator/car_state/odom" to="car_state/odom"/>
      <remap from="f1tenth_simulator/car_state/pose" to="car_state/pose"/>
    </include>
    
    <!-- Per-car frenet conversion with parameterized topics -->
    <include file="$(find frenet_odom_republisher)/launch/frenet_odom_republisher.launch">
      <arg name="input_odom_topic" value="car_state/odom"/>
      <arg name="output_odom_topic" value="car_state/odom_frenet"/>
      <arg name="global_waypoints_topic" value="/global_waypoints"/>
    </include>
    
    <!-- ============================================= -->
    <!-- ESSENTIAL RELAYS: Only keep critical ones   -->
    <!-- ============================================= -->
    
    <!-- CRITICAL: Simulator Data Bridging (Cannot be replaced with remapping) -->
    <!-- Note: These relays are essential because the simulator publishes with specific topic names -->
    <node pkg="topic_tools" type="relay" name="car_state_odom_relay" 
          args="f1tenth_simulator/car_state/odom car_state/odom" />
    <node pkg="topic_tools" type="relay" name="car_state_pose_relay" 
          args="f1tenth_simulator/car_state/pose car_state/pose" />
    <node pkg="topic_tools" type="relay" name="car_state_pitch_relay" 
          args="f1tenth_simulator/car_state/pitch car_state/pitch" />
    <node pkg="topic_tools" type="relay" name="scan_relay" 
          args="f1tenth_simulator/scan scan" />
    
    <!-- CRITICAL: Global-to-Namespaced Topic Bridging -->
    <!-- Note: These are essential for multi-car coordination -->
    <node pkg="topic_tools" type="relay" name="planner_waypoints_relay" 
          args="/planner/avoidance/otwpnts planner/avoidance/otwpnts" />
    
    <!-- CRITICAL: Global Waypoint Relays -->
    <node pkg="topic_tools" type="relay" name="global_waypoints_relay" 
          args="/global_waypoints global_waypoints" />
    <node pkg="topic_tools" type="relay" name="global_waypoints_scaled_relay" 
          args="/global_waypoints_scaled global_waypoints_scaled" />
    
    <!-- REMOVED: planner_to_controller_relay - this bypassed the state machine -->
    <!-- The correct flow is: planner -> state_machine -> controller -->
    <!-- State machine converts OTWpntArray to WpntArray as required by controller -->
    
    <!-- CRITICAL: Control Pipeline Relays (Required for mux architecture) -->
    <node pkg="topic_tools" type="relay" name="controller_to_mux_relay" 
          args="nav_drive mux_controller/nav_drive" />
    <node pkg="topic_tools" type="relay" name="mux_to_simulator_relay" 
          args="mux_controller/vesc/high_level/ackermann_cmd_mux/input/nav_1 f1tenth_simulator/vesc/high_level/ackermann_cmd_mux/input/nav_1" />
    
    <!-- ============================================= -->
    <!-- OPTIMIZATION: Reduced Behavior Controller Integration -->
    <!-- ============================================= -->
    <!-- Streamlined behavior controller with direct topic access where possible -->
    
    <!-- ESSENTIAL: Behavior Controller Mux Control -->
    <node pkg="topic_tools" type="relay" name="behavior_mux_relay" 
          args="behavior_controller/mux mux_controller/mux" />
    
    <!-- REMOVED: behavior_odom_relay & behavior_scan_relay -->
    <!-- OPTIMIZATION: Behavior controller should subscribe directly to car_state/odom and scan -->
    <!-- This eliminates 2 relay nodes per car -->
    
    <!-- Auto-enable navigation mux for reliable autonomous operation -->
    <node pkg="rostopic" type="rostopic" name="auto_enable_nav_mux"
          args="pub -r 10 behavior_controller/mux std_msgs/Int32MultiArray 'data: [0, 1, 0, 0, 0]'" />
          
    <!-- Set initial pose for car1 in its own namespace -->
    <node pkg="rostopic" type="rostopic" name="car1_initial_pose"
          args="pub -1 f1tenth_simulator/initialpose geometry_msgs/PoseWithCovarianceStamped &quot;{header: {frame_id: car1_map}, pose: {pose: {position: {x: -2.0, y: -1.0, z: 0.0}, orientation: {x: 0.0, y: 0.0, z: 0.0, w: 1.0}}}}&quot;" />
          
    <!-- TF Frame Configuration -->
        <!-- TF Frame Configuration -->
    <include file="$(find stack_master)/launch/namespaced_static_transforms.launch">
      <arg name="frame_prefix" value="$(arg frame_prefix_car1)"/>
      <!-- Pass scan distance parameter if available, otherwise use default -->
      <arg name="scan_distance_to_base_link" value="0.275"/>
      <arg name="scan_height" value="0.19"/>
      <!-- Disable odom->base_link since simulator handles this -->
      <arg name="publish_odom_base" value="False"/>
    </include>
        <group if="$(arg use_global_map)">
      <node pkg="tf" type="static_transform_publisher" name="car1_global_map_link"
            args="0 0 0 0 0 0 $(arg global_map_frame) $(arg frame_prefix_car1)map 10" />
    </group>
  </group>

  <!-- Car 2 - Optimized Configuration (Mirror of Car 1) -->
  <group if="$(eval car2 != '')" ns="$(arg car2)">
    <param name="frame_prefix" value="$(arg frame_prefix_car2)"/>
    <!-- Set frame parameters for f1tenth_simulator to use prefixed frames -->
    <param name="f1tenth_simulator/base_frame" value="$(arg frame_prefix_car2)base_link"/>
    <param name="f1tenth_simulator/scan_frame" value="$(arg frame_prefix_car2)laser"/>
    <param name="f1tenth_simulator/map_frame" value="$(arg frame_prefix_car2)map"/>
    <!-- Set car2 initial position -->
    <param name="f1tenth_simulator/car_init_x" value="-2.0"/>
    <param name="f1tenth_simulator/car_init_y" value="1.0"/>
    <param name="f1tenth_simulator/car_init_theta" value="0.0"/>
    
    <!-- Headtohead Planning with Per-Car Topic Isolation -->
    <include file="$(find stack_master)/launch/headtohead.launch">
      <arg name="car_name" value="$(arg car2)"/>
      <arg name="planner" value="$(arg planner_car2)"/>
      <arg name="racecar_version" value="$(arg version_car2)"/>
      <arg name="measure" value="False"/>
      <arg name="map_name" value="$(arg map_car2)"/>
      <!-- OPTIMIZATION: Parameterized topics for proper namespace isolation -->
      <arg name="global_waypoints_topic" value="/global_waypoints"/>
      <arg name="global_waypoints_scaled_topic" value="/global_waypoints_scaled"/>
      <arg name="global_waypoints_overtaking_topic" value="/global_waypoints/overtaking"/>
      <arg name="planner_output_topic" value="planner/avoidance/otwpnts"/>
    </include>
    
    <!-- Base System with Enhanced Remapping -->
    <include file="$(find stack_master)/launch/base_system.launch">
      <arg name="map_name" value="$(arg map_car2)"/>
      <arg name="racecar_version" value="$(arg version_car2)"/>
      <arg name="sim" value="$(arg sim)"/>
      <arg name="frame_prefix" value="$(arg frame_prefix_car2)"/>
      <arg name="rviz" value="False"/>
      <arg name="include_frenet_republisher" value="False"/>
      <!-- OPTIMIZATION: Direct topic remapping for simulator integration -->
      <remap from="f1tenth_simulator/scan" to="scan"/>
      <remap from="f1tenth_simulator/car_state/odom" to="car_state/odom"/>
      <remap from="f1tenth_simulator/car_state/pose" to="car_state/pose"/>
    </include>
    
    <!-- Per-car frenet conversion with parameterized topics -->
    <include file="$(find frenet_odom_republisher)/launch/frenet_odom_republisher.launch">
      <arg name="input_odom_topic" value="car_state/odom"/>
      <arg name="output_odom_topic" value="car_state/odom_frenet"/>
      <arg name="global_waypoints_topic" value="/global_waypoints"/>
    </include>
    
    <!-- ESSENTIAL RELAYS: Only keep critical ones -->
    <node pkg="topic_tools" type="relay" name="car_state_odom_relay" 
          args="f1tenth_simulator/car_state/odom car_state/odom" />
    <node pkg="topic_tools" type="relay" name="car_state_pose_relay" 
          args="f1tenth_simulator/car_state/pose car_state/pose" />
    <node pkg="topic_tools" type="relay" name="car_state_pitch_relay" 
          args="f1tenth_simulator/car_state/pitch car_state/pitch" />
    <node pkg="topic_tools" type="relay" name="scan_relay" 
          args="f1tenth_simulator/scan scan" />
    
    <!-- CRITICAL: Global-to-Namespaced Topic Bridging -->
    <node pkg="topic_tools" type="relay" name="planner_waypoints_relay" 
          args="/planner/avoidance/otwpnts planner/avoidance/otwpnts" />
    
    <!-- CRITICAL: Global Waypoint Relays -->
    <node pkg="topic_tools" type="relay" name="global_waypoints_relay" 
          args="/global_waypoints global_waypoints" />
    <node pkg="topic_tools" type="relay" name="global_waypoints_scaled_relay" 
          args="/global_waypoints_scaled global_waypoints_scaled" />
    
    <!-- REMOVED: planner_to_controller_relay - this bypassed the state machine -->
    <!-- The correct flow is: planner -> state_machine -> controller -->
    <!-- State machine converts OTWpntArray to WpntArray as required by controller -->
    
    <!-- CRITICAL: Control Pipeline Relays (Required for mux architecture) -->
    <node pkg="topic_tools" type="relay" name="controller_to_mux_relay" 
          args="nav_drive mux_controller/nav_drive" />
    <node pkg="topic_tools" type="relay" name="mux_to_simulator_relay" 
          args="mux_controller/vesc/high_level/ackermann_cmd_mux/input/nav_1 f1tenth_simulator/vesc/high_level/ackermann_cmd_mux/input/nav_1" />
    
    <!-- ESSENTIAL: Behavior Controller Mux Control -->
    <node pkg="topic_tools" type="relay" name="behavior_mux_relay" 
          args="behavior_controller/mux mux_controller/mux" />
    
    <!-- Auto-enable navigation mux for reliable autonomous operation -->
    <node pkg="rostopic" type="rostopic" name="auto_enable_nav_mux_car2"
          args="pub -r 10 behavior_controller/mux std_msgs/Int32MultiArray 'data: [0, 1, 0, 0, 0]'" />
          
    <!-- Set initial pose for car2 in its own namespace -->
    <node pkg="rostopic" type="rostopic" name="car2_initial_pose"
          args="pub -1 f1tenth_simulator/initialpose geometry_msgs/PoseWithCovarianceStamped &quot;{header: {frame_id: car2_map}, pose: {pose: {position: {x: -2.0, y: 1.0, z: 0.0}, orientation: {x: 0.0, y: 0.0, z: 0.0, w: 1.0}}}}&quot;" />
          
    <!-- TF Frame Configuration -->
    <include file="$(find stack_master)/launch/namespaced_static_transforms.launch">
      <arg name="frame_prefix" value="$(arg frame_prefix_car2)"/>
      <!-- Pass scan distance parameter if available, otherwise use default -->
      <arg name="scan_distance_to_base_link" value="0.275"/>
      <arg name="scan_height" value="0.19"/>
      <!-- Disable odom->base_link since simulator handles this -->
      <arg name="publish_odom_base" value="False"/>
    </include>
        <group if="$(arg use_global_map)">
      <node pkg="tf" type="static_transform_publisher" name="car2_global_map_link"
            args="0 0 0 0 0 0 $(arg global_map_frame) $(arg frame_prefix_car2)map 10" />
    </group>
  </group>

  <!-- ============================================= -->
  <!-- FUTURE EXTENSION: Car 3 & 4 Templates       -->
  <!-- ============================================= -->
  <!-- Additional cars (3 & 4) can be enabled by setting car3 / car4 args -->
  <!-- These follow the same optimized pattern as cars 1 & 2 -->
  
  <group if="$(eval car3 != '')" ns="$(arg car3)">
    <param name="frame_prefix" value="$(arg frame_prefix_car3)"/>
    <include file="$(find stack_master)/launch/headtohead.launch">
      <arg name="car_name" value="$(arg car3)"/>
      <arg name="planner" value="$(arg planner_car3)"/>
      <arg name="racecar_version" value="$(arg version_car3)"/>
      <arg name="measure" value="False"/>
      <arg name="map_name" value="$(arg map_car3)"/>
    </include>
    <include file="$(find stack_master)/launch/base_system.launch">
      <arg name="map_name" value="$(arg map_car3)"/>
      <arg name="racecar_version" value="$(arg version_car3)"/>
      <arg name="sim" value="$(arg sim)"/>
      <arg name="frame_prefix" value="$(arg frame_prefix_car3)"/>
      <arg name="rviz" value="False"/>
      <arg name="include_frenet_republisher" value="False"/>
    </include>
    <include file="$(find stack_master)/launch/namespaced_static_transforms.launch">
      <arg name="frame_prefix" value="$(arg frame_prefix_car3)"/>
    </include>
    <group if="$(arg use_global_map)">
      <node pkg="tf" type="static_transform_publisher" name="car3_global_map_link"
            args="0 0 0 0 0 0 $(arg global_map_frame) $(arg frame_prefix_car3)map 10" />
    </group>
  </group>

  <group if="$(eval car4 != '')" ns="$(arg car4)">
    <param name="frame_prefix" value="$(arg frame_prefix_car4)"/>
    <include file="$(find stack_master)/launch/headtohead.launch">
      <arg name="car_name" value="$(arg car4)"/>
      <arg name="planner" value="$(arg planner_car4)"/>
      <arg name="racecar_version" value="$(arg version_car4)"/>
      <arg name="measure" value="False"/>
      <arg name="map_name" value="$(arg map_car4)"/>
    </include>
    <include file="$(find stack_master)/launch/base_system.launch">
      <arg name="map_name" value="$(arg map_car4)"/>
      <arg name="racecar_version" value="$(arg version_car4)"/>
      <arg name="sim" value="$(arg sim)"/>
      <arg name="frame_prefix" value="$(arg frame_prefix_car4)"/>
      <arg name="rviz" value="False"/>
      <arg name="include_frenet_republisher" value="False"/>
    </include>
    <include file="$(find stack_master)/launch/namespaced_static_transforms.launch">
      <arg name="frame_prefix" value="$(arg frame_prefix_car4)"/>
    </include>
    <group if="$(arg use_global_map)">
      <node pkg="tf" type="static_transform_publisher" name="car4_global_map_link"
            args="0 0 0 0 0 0 $(arg global_map_frame) $(arg frame_prefix_car4)map 10" />
    </group>
  </group>

  <!-- ============================================= -->
  <!-- GLOBAL CONFIGURATION & PARAMETERS           -->
  <!-- ============================================= -->
  
  <!-- Load global parameters required by various nodes -->
  <rosparam ns="map_params" command="load" file="$(find stack_master)/maps/$(arg global_map)/speed_scaling.yaml"/>
  <rosparam ns="ot_map_params" command="load" file="$(find stack_master)/maps/$(arg global_map)/ot_sectors.yaml"/>
  
  <!-- Load state machine parameters globally for FTG access -->
  <rosparam ns="state_machine" command="load" file="$(find stack_master)/config/state_machine_params.yaml"/>
  
  <!-- Load velocity scaler debug parameter globally -->
  <param name="/velocity_scaler/debug_plot" value="false"/>
  
  <!-- Set global sim parameter -->
  <param name="/sim" value="$(arg sim)"/>
  
  <!-- Set ROS time parameters for proper timestamp handling -->
  <param name="/use_sim_time" value="false"/>
  <rosparam param="/clock">{now: true}</rosparam>

  <!-- Single consolidated RViz outside namespaces -->
  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="multi_car_rviz" args="-d $(find stack_master)/rviz/multi_car.rviz" output="screen"/>
  </group>

  <!-- ============================================= -->
  <!-- MULTI-CAR INTERACTION SYSTEM                -->
  <!-- ============================================= -->
  <!-- Enables inter-car perception and collision detection -->
  
  <group if="$(arg enable_car_interaction)">
    <include file="$(find multi_car_interaction)/launch/multi_car_interaction.launch">
      <arg name="car_names" value="car1, car2"/>
      <arg name="enable_collision_detection" value="$(arg enable_collision_detection)"/>
      <arg name="enable_obstacle_publishing" value="True"/>
      <arg name="warning_distance" value="$(arg collision_warning_distance)"/>
      <arg name="critical_distance" value="$(arg collision_critical_distance)"/>
      <arg name="collision_distance" value="0.5"/>
      <arg name="publish_rate" value="20.0"/>
      <arg name="check_rate" value="50.0"/>
    </include>
  </group>

</launch>
