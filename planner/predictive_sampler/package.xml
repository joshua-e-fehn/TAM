<?xml version="1.0"?>
<package format="2">
  <name>predictive_sampler</name>
  <version>1.0.0</version>
  <description>Predictive Sampler Planner - Hybrid planner combining Predictive Spliner transitions with TAM Sampling overtaking</description>

  <maintainer email="team@tam.racing">TAM Racing Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- ROS1 dependencies -->
  <build_depend>roscpp</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>dynamic_reconfigure</build_depend>

  <!-- Custom message dependencies -->
  <build_depend>f110_msgs</build_depend>

  <!-- Runtime dependencies -->
  <exec_depend>roscpp</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>dynamic_reconfigure</exec_depend>
  <exec_depend>f110_msgs</exec_depend>

  <!-- Planner dependencies -->
  <depend>predictive_spliner</depend>
  <depend>tam_sampling_planner</depend>

  <export>
  </export>
</package>
